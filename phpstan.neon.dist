# PHPStan configuration for Generative SEO Kit Bundle
# Compatible with PHP 8.2+ and Symfony 7.4 / 8.x
# Extensions (phpstan-symfony, phpstan-phpunit) are auto-included via phpstan/extension-installer.

parameters:
    level: 8
    paths:
        - src
        - tests
    excludePaths:
        - demo/*
    ignoreErrors: []

includes:
  - vendor/nowo-tech/phpstan-frankenphp/ruleset-classic.neon
  - vendor/nowo-tech/phpstan-frankenphp/ruleset-worker.neon
