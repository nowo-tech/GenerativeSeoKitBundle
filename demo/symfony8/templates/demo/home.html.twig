{% extends 'base.html.twig' %}

{% block nowo_ui_page_header %}
    {{ include(nowo_ui_partial('page_header'), {
        title: 'Generative SEO Kit',
        intro: 'AI crawler policy, llms.txt, and citations on top of SeoKit.',
    }) }}
{% endblock %}

{% block body %}
    {% embed '@NowoUiKit/demo_platform/_section.html.twig' with {title: 'Generated endpoints', intro: 'Served by the bundle from its configuration; open each one to see the output.', kind: 'list', testid: 'demo-endpoints'} %}
        {% block section_body %}
            <ul>
                <li><a class="nowo-ui-link" href="/llms.txt">/llms.txt</a></li>
                <li><a class="nowo-ui-link" href="/.well-known/llms.txt">/.well-known/llms.txt</a></li>
                <li><a class="nowo-ui-link" href="/robots.txt">/robots.txt</a></li>
                <li><a class="nowo-ui-link" href="/sitemap.xml">/sitemap.xml</a></li>
            </ul>
        {% endblock %}
    {% endembed %}
{% endblock %}
