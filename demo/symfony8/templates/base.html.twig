{#- REQ-DEMO-014: the demo runs inside UiKit's shared demo platform shell. This file only declares the demo; SeoKit's head
    tags are printed in the head block. -#}
{% extends '@NowoUiKit/demo_platform/layout.html.twig' %}
{% set nowo_ui_demo_platform = {
    bundle: 'Generative SEO Kit',
    home_route: 'app_home',
    repository: 'https://github.com/nowo-tech/GenerativeSeoKitBundle',
    translation_domain: false,
    nav: [
        {label: 'Overview', route: 'app_home'},
        {label: 'llms.txt', href: '/llms.txt', section: 'Generated files', testid: 'demo-nav-llms'},
        {label: 'robots.txt', href: '/robots.txt', section: 'Generated files', testid: 'demo-nav-robots'},
        {label: 'sitemap.xml', href: '/sitemap.xml', section: 'Generated files', testid: 'demo-nav-sitemap'},
    ],
} %}
{% block nowo_ui_document_title %}{% block title %}Generative SEO Kit Demo{% endblock %}{% endblock %}

{% block nowo_ui_head %}
    {{ parent() }}
    {{ nowo_seo_head() }}
{% endblock %}

{% block nowo_ui_content %}{% block body %}{% endblock %}{% endblock %}
